 from .utils import *
 
+# --- local: radius_graph without torch-cluster ---
+def _radius_graph_fallback(pos, r, loop=False):
+    """Dense pairwise equivalent of torch_cluster.radius_graph.
+    Same output semantics (edge_index, both directions, self-loops optional).
+    Graphs here are a few hundred residues, so the dense distance matrix is cheap."""
+    d = torch.cdist(pos, pos)
+    mask = d < r
+    if not loop:
+        mask.fill_diagonal_(False)
+    row, col = mask.nonzero(as_tuple=True)
+    return torch.stack([col, row], dim=0)
+
+def _radius_graph(pos, r, loop=False):
+    try:
+        return gnn.radius_graph(pos, r=r, loop=loop)
+    except ImportError:
+        return _radius_graph_fallback(pos, r, loop=loop)
+# --- end local ---
+
